---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Button from '../../components/Button.astro';
import { clinicInfo } from '../../utils/clinicInfo';
// Import images
import { HERO_IMAGES } from '../../utils/images';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Locations', href: '#' },
  { label: 'Dentist near Belton', href: '/locations/dentist-belton' },
];
---

<Layout
  title="Dentist near Belton, TX | Revital Dental"
  description="Looking for a top-rated dentist near Belton TX? Revital Dental is located just minutes away in Temple. 5-Star family & cosmetic dentistry serving the 76513 community."
>
  <Hero
    title="Dentist Near Belton & Troy"
    subtitle="5-Star Dental Care just minutes from Belton TX"
    images={[HERO_IMAGES.dental1]}
    height="md"
  />

  <Breadcrumbs items={breadcrumbItems} />

  <div class="py-16 bg-white">
    <div class="container mx-auto px-4">
      
      <!-- Intro Section -->
      <section class="mb-16 max-w-4xl mx-auto text-center" data-aos="fade-up">
        <h2 class="text-3xl font-bold font-heading text-gray-800 mb-6">Convenient Dental Care for Belton Residents</h2>
        <p class="text-lg text-gray-600 mb-6">
          If you live in <strong>Belton, Troy, or Morgan's Point Resort</strong>, you deserve a dentist who is easy to reach and provides exceptional care. 
          <strong>{clinicInfo.name}</strong> is located conveniently on <strong>South 31st Street</strong> in Temple, making us the perfect choice for local families.
        </p>
        <p class="text-lg text-gray-600">
          We are just a short drive from Belton! Skip the long commute and visit a top-rated practice right in your neighborhood.
        </p>
      </section>

      <!-- Why Drive a Few Minutes? -->
      <section class="mb-16" data-aos="fade-up">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
          <div>
            <h3 class="text-2xl font-bold font-heading text-gray-800 mb-4">Why Choose Revital Dental?</h3>
            <ul class="space-y-4">
              <li class="flex items-start gap-3">
                <div class="w-6 h-6 rounded-full bg-green-100 text-green-600 flex items-center justify-center flex-shrink-0">✓</div>
                <span class="text-gray-700"><strong>State-of-the-Art Facility:</strong> Modern digital imaging and comfortable amenities.</span>
              </li>
              <li class="flex items-start gap-3">
                <div class="w-6 h-6 rounded-full bg-green-100 text-green-600 flex items-center justify-center flex-shrink-0">✓</div>
                <span class="text-gray-700"><strong>Comprehensive Care:</strong> From checkups to implants and Invisalign, we do it all under one roof.</span>
              </li>
              <li class="flex items-start gap-3">
                <div class="w-6 h-6 rounded-full bg-green-100 text-green-600 flex items-center justify-center flex-shrink-0">✓</div>
                <span class="text-gray-700"><strong>Insurance Friendly:</strong> We accept most PPO plans including Delta, Cigna, and MetLife.</span>
              </li>
              <li class="flex items-start gap-3">
                <div class="w-6 h-6 rounded-full bg-green-100 text-green-600 flex items-center justify-center flex-shrink-0">✓</div>
                <span class="text-gray-700"><strong>Easy Parking:</strong> Spacious parking lot right off S 31st Street.</span>
              </li>
            </ul>
            <div class="mt-8">
              <Button
                href={clinicInfo.booking.url}
                text="Book an Appointment"
                variant="primary"
              />
            </div>
          </div>
          <!-- Map Embed -->
          <div class="rounded-xl overflow-hidden shadow-lg h-[400px] border border-gray-200">
             <iframe 
                width="100%" 
                height="100%" 
                style="border:0;" 
                loading="lazy" 
                allowfullscreen 
                src={`https://maps.google.com/maps?q=${encodeURIComponent(clinicInfo.address.full)}&t=&z=13&ie=UTF8&iwloc=&output=embed`}>
            </iframe>
          </div>
        </div>
      </section>

      <!-- Driving Directions -->
      <section class="max-w-3xl mx-auto bg-gray-50 p-8 rounded-xl border border-gray-100" data-aos="fade-up">
        <h3 class="text-xl font-bold font-heading text-gray-800 mb-4">Driving Directions from Belton TX</h3>
        <ol class="list-decimal list-inside space-y-3 text-gray-600">
          <li>Head <strong>North</strong> towards Temple.</li>
          <li>Take the exit for <strong>South 31st Street</strong>.</li>
          <li>Continue straight on S 31st St.</li>
          <li><strong>{clinicInfo.name}</strong> will be on your right at 4311 S 31st St Ste 145.</li>
        </ol>
        <p class="mt-6 text-sm text-gray-500 italic">
          *You will find us at 4311 S 31st St, Suite 145 in Temple — easy parking and quick access for patients in 76513 and 76502.
        </p>
      </section>

    </div>
  </div>
</Layout>
