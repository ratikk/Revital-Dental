---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { blogPosts } from '../../utils/blogPosts';
import { clinicInfo } from '../../utils/clinicInfo';
import { Image } from 'astro:assets';
import { HERO_IMAGES } from '../../utils/images'; // Use a generic image for the header background

export async function getStaticPaths() {
  // Drafts are kept in the repo but never built (no page, no sitemap entry).
  return blogPosts.filter(post => !post.draft).map(post => ({
    params: { slug: post.id },
    props: { post }
  }));
}

const { post } = Astro.props;

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: '/blog' },
  { label: post.title, href: `/blog/${post.id}` },
];

const pageTitle = post.seoTitle || post.title;
const pageDescription = post.seoDescription || post.excerpt;
const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.title,
  "description": pageDescription,
  "datePublished": post.date,
  // Team-authored posts credit the practice; a named reviewer is added only
  // once that clinician has approved the final text.
  "author": post.author === 'Revital Dental Team'
    ? { "@id": "https://revitaldentaltempletx.com#dentist" }
    : { "@type": "Person", "name": post.author },
  ...(post.reviewedBy ? { "reviewedBy": { "@type": "Person", "name": post.reviewedBy } } : {}),
  "publisher": { "@id": "https://revitaldentaltempletx.com#dentist" },
  "mainEntityOfPage": `https://revitaldentaltempletx.com/blog/${post.id}/`,
};

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://revitaldentaltempletx.com').toString();


// Handle Image Logic
const isAstroImage = post.image && typeof post.image === 'object' && 'src' in post.image;
const ogImage = isAstroImage
  // @ts-ignore
  ? new URL(post.image.src, Astro.site || 'https://revitaldentaltempletx.com').toString()
  : new URL("/images/logo.png", Astro.site || 'https://revitaldentaltempletx.com').toString();
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalURL={canonicalURL}
  og={{
    title: pageTitle,
    description: pageDescription,
    image: ogImage,
    type: "article",
    publishedTime: new Date(post.date).toISOString(),
    authors: [post.author],
    section: post.category,
    tags: post.tags,
    url: canonicalURL,
    site_name: "Revital Dental"
  }}
>
  <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
  {/* 1. GENERIC SMALL HEADER (Not the huge blog image) */}
  <Hero
    headingTag="p"
    title="Dental Health Blog"
    subtitle="Expert Advice from Revital Dental"
    images={['/images/hero/dental-3.jpg']} 
    height="xs" 
    showAppointmentForm={false}
    isHomePage={false}
    overlay={true}
  />

  <Breadcrumbs items={breadcrumbItems} class="py-4 bg-gray-50 border-b border-gray-200"/>

  <div class="py-12 bg-white">
    <div class="container mx-auto px-4 max-w-4xl"> {/* Restricted width for reading comfort */}
      <article>
        {/* Header Section */}
        <header class="mb-8 text-center">
          <div class="flex flex-wrap justify-center items-center gap-3 text-sm text-gray-500 mb-4">
             <span class="bg-primary-50 text-primary-700 px-3 py-1 rounded-full font-medium">
               {post.category}
             </span>
             <span>&bull;</span>
             <time datetime={post.date}>
               {new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
             </time>
          </div>
          
          <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold font-heading text-gray-900 mb-6 leading-tight">
            {post.title}
          </h1>

          <div class="text-gray-600 font-medium">
            {post.author === 'Revital Dental Team' ? 'Written by' : 'By'} {post.author}
            {post.reviewedBy && (
              <span class="block text-sm text-gray-500 mt-1">Clinically reviewed by {post.reviewedBy}</span>
            )}
          </div>
        </header>

        {/* 2. THE BLOG IMAGE (Contained, Rounded, Nice looking) */}
        {post.image && (
          <div class="mb-10 rounded-xl overflow-hidden shadow-lg mx-auto max-w-3xl">
            {isAstroImage ? (
              <Image
                // @ts-ignore
                src={post.image}
                alt={post.title}
                class="w-full h-auto object-cover"
                loading="eager"
                width={1024}
                height={576}
              />
            ) : (
              <img
                // @ts-ignore
                src={post.image}
                alt={post.title}
                class="w-full h-auto object-cover"
              />
            )}
          </div>
        )}

        {/* Content Body */}
        <div class="prose prose-lg prose-primary mx-auto text-gray-700" set:html={post.content} />

        {/* FAQ accordion (visible only; no FAQPage JSON-LD — Google retired FAQ rich results in 2026) */}
        {post.faq && post.faq.length > 0 && (
          <section class="mt-12" aria-labelledby="faq-heading">
            <h2 id="faq-heading" class="text-2xl font-bold font-heading text-gray-800 mb-6">Frequently Asked Questions</h2>
            <div class="space-y-4">
              {post.faq.map(f => (
                <details class="group bg-gray-50 border border-gray-100 rounded-xl p-5">
                  <summary class="cursor-pointer font-semibold text-gray-800 list-none flex justify-between items-center gap-4">
                    <span>{f.question}</span>
                    <span class="text-primary-600 transition-transform group-open:rotate-45 text-xl leading-none" aria-hidden="true">+</span>
                  </summary>
                  <p class="mt-3 text-gray-600 leading-relaxed">{f.answer}</p>
                </details>
              ))}
            </div>
          </section>
        )}

        {/* Tags Footer */}
        {post.tags && (
          <div class="mt-12 pt-6 border-t border-gray-100">
            <h3 class="text-sm font-semibold text-gray-500 mb-3 uppercase tracking-wider">Related Topics:</h3>
            <div class="flex flex-wrap gap-2">
              {post.tags.map(tag => (
                <span class="px-3 py-1 bg-gray-100 text-gray-600 rounded-md text-sm hover:bg-gray-200 transition-colors cursor-default">
                  #{tag}
                </span>
              ))}
            </div>
          </div>
        )}

        {/* End-of-article CTA — every post ends with a next step.
            Mirrors the NextGen pattern; tracked via data-cta-zone. */}
        <div class="mt-12 bg-primary-50 p-8 rounded-2xl border border-primary-100 text-center" data-cta-zone="article-end">
          <h2 class="text-2xl font-bold font-heading text-gray-800 mb-3">
            Have Questions About Your Smile?
          </h2>
          <p class="text-gray-600 mb-6 max-w-xl mx-auto">
            Our Temple team is happy to help — book online in under a minute, or
            give us a call.
          </p>
          <div class="flex flex-wrap justify-center gap-4">
            <a
              href={clinicInfo.booking.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center rounded-md bg-primary-600 hover:bg-primary-700 text-white font-semibold text-lg px-6 py-2.5 shadow-sm transition-colors"
            >
              Book Appointment
            </a>
            <a
              href="tel:+12542275777"
              class="inline-flex items-center justify-center rounded-md border border-primary-600 text-primary-600 hover:bg-primary-100 font-semibold text-lg px-6 py-2.5 transition-colors"
            >
              Call {clinicInfo.phone}
            </a>
          </div>
        </div>

        {/* Back Button */}
        <div class="mt-10 text-center">
          <a href="/blog" class="inline-flex items-center text-primary-600 hover:text-primary-800 font-semibold transition-colors">
            &larr; Back to Articles
          </a>
        </div>

      </article>
    </div>
  </div>
</Layout>
