---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Button from '../components/Button.astro';
import BeforeAfterGallery from '../components/BeforeAfterGallery.tsx';
import { clinicInfo } from '../utils/clinicInfo';
import { galleryCases } from '../utils/galleryCases';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Smile Gallery', href: '/smile-gallery' },
];

const transformations = [...galleryCases];
---

<Layout
  title="Smile Gallery | Before & After | Revital Dental Temple"
  description="See real patient results. Explore before and after photos of restorations, crowns, whitening, and Invisalign at Revital Dental in Temple, TX."
>
  <!-- CLEAN, SLIM HEADER (No Big Image) -->
  <div class="bg-primary-900 text-white pt-32 pb-16 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <svg class="h-full w-full" viewBox="0 0 100 100" preserveAspectRatio="none">
        <path d="M0 100 C 20 0 50 0 100 100 Z" fill="white" />
      </svg>
    </div>
    
    <div class="container mx-auto px-4 text-center relative z-10">
      <h1 class="text-4xl md:text-5xl font-bold font-heading mb-4">Smile Transformations</h1>
      <p class="text-primary-200 text-lg max-w-2xl mx-auto">
        Real patients. Real results. See what modern dentistry can do for you.
      </p>
    </div>
  </div>

  <!-- Breadcrumbs -->
  <div class="bg-gray-50 border-b border-gray-200">
    <div class="container mx-auto px-4 py-3">
      <nav class="flex text-sm text-gray-500" aria-label="Breadcrumb">
        <ol class="flex items-center space-x-2">
          <li><a href="/" class="hover:text-primary-600">Home</a></li>
          <li><span class="text-gray-400">/</span></li>
          <li class="text-gray-900 font-medium" aria-current="page">Smile Gallery</li>
        </ol>
      </nav>
    </div>
  </div>

  <div class="py-16 bg-white">
    <div class="container mx-auto px-4">
      
      <!-- Gallery Grid -->
      <section class="mb-20" data-aos="fade-up" aria-labelledby="gallery-heading">
        <div class="max-w-3xl mx-auto text-center mb-16">
          <h2 id="gallery-heading" class="text-3xl md:text-4xl font-bold font-heading text-gray-900 mb-4">
            Real Smiles. Thoughtful Results.
          </h2>
          <p class="text-lg text-gray-600">
            Explore before-and-after results from patients treated at Revital Dental.
            Every smile and treatment plan is unique.
          </p>
        </div>

        <BeforeAfterGallery transformations={transformations} />

        <p class="max-w-3xl mx-auto text-center text-sm text-gray-500 mt-16 border-t border-gray-100 pt-6">
          Actual patient results. Individual results vary. Images are shared with
          patient authorization. A consultation is required to determine which
          treatment options are appropriate for you.
        </p>
      </section>

      <!-- CTA Section -->
      <section class="max-w-3xl mx-auto text-center" data-aos="fade-up" data-cta-zone="smile-gallery">
        <div class="bg-primary-50 p-8 rounded-2xl border border-primary-100 shadow-sm">
          <h2 class="text-3xl font-bold font-heading text-gray-900 mb-4">
            Ready to talk about your smile?
          </h2>
          <p class="text-gray-600 mb-8 text-lg">
            Schedule a consultation to explore the treatment options that may be right for you.
          </p>
          <div class="flex flex-wrap justify-center gap-4">
            <Button
              href={clinicInfo.booking.url}
              text="Book Consultation"
              variant="primary"
              size="lg"
              target="_blank"
              rel="noopener noreferrer"
            />
            <Button
              href="tel:+12542275777"
              text="Call Us"
              variant="outline"
              size="lg"
              class="bg-white hover:bg-gray-50"
            />
          </div>
        </div>
      </section>
    </div>
  </div>
</Layout>
