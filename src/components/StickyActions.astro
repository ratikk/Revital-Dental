---
/**
 * Persistent Call | Book bar, mobile only. Ported from
 * ratikk/NextGen-Dental src/components/StickyActions.astro — keep in sync.
 *
 * Puts both primary actions in the thumb zone on every page. Hidden from lg
 * up, where the header already shows Call and Book Now.
 */
import { clinicInfo } from '../utils/clinicInfo';

const rawPhone = clinicInfo.phone.replace(/\D/g, '');
const telHref = `tel:+1${rawPhone.slice(-10)}`;
---

<div
  data-cta-zone="sticky"
  class="lg:hidden fixed bottom-0 inset-x-0 z-40 grid grid-cols-2 gap-px bg-gray-200 border-t border-gray-200 shadow-[0_-2px_10px_rgba(0,0,0,0.08)] pb-[env(safe-area-inset-bottom)] transition-transform duration-200 will-change-transform"
>
  <a
    href={telHref}
    class="flex items-center justify-center gap-2 min-h-[56px] bg-primary-600 text-white font-semibold hover:bg-primary-700 transition-colors"
    aria-label={`Call ${clinicInfo.displayPhone}`}
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
    </svg>
    Call
  </a>
  <a
    href={clinicInfo.booking.url}
    target="_blank"
    rel="noopener noreferrer"
    class="flex items-center justify-center gap-2 min-h-[56px] bg-white text-primary-700 font-semibold hover:bg-primary-50 transition-colors"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
    </svg>
    Book Online
  </a>
</div>

<script>
  /*
   * Hide the bar while the hero CTA pair is on screen; slide it in once they
   * scroll away, so exactly one primary Call/Book pair is visible at a time.
   * Default is VISIBLE and JS hides it — no-JS browsers still get the bar.
   */
  const bar = document.querySelector('[data-cta-zone="sticky"]');
  const heroCtas = document.querySelector('[data-cta-zone="hero"]');
  if (bar && heroCtas && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          // inert removes the off-screen links from the focus order and the
          // a11y tree together; aria-hidden alone leaves them tabbable.
          bar.classList.add('translate-y-full');
          bar.setAttribute('aria-hidden', 'true');
          bar.setAttribute('inert', '');
        } else {
          bar.classList.remove('translate-y-full');
          bar.setAttribute('aria-hidden', 'false');
          bar.removeAttribute('inert');
        }
      },
      { threshold: 0.25 }
    );
    io.observe(heroCtas);
  }
</script>
